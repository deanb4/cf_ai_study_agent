{
  "name": "chat-agent",
  "main": "src/server.ts",
  // Set this to today's date
  "compatibility_date": "2026-03-16",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "assets": { "directory": "./client/dist" },
  "durable_objects": {
    "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
  },
   "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MyDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatAgent"], "deleted_classes": ["MyDurableObject"] }
  ],
  
}

